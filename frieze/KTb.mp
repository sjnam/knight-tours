% KTb.mp — 크누스의 나이트 투어 전시장, 3xN 길고 가는 투어 셋.
%
% 원본은 그의 사진 KTb.jpg다.
%   https://cs.stanford.edu/~knuth/KTb.jpg
% 벽에 세로로 나란히 걸린 띠 셋인데, 셋 다 폭이 3칸이고 저마다 하나의 닫힌
% 나이트 투어다. 여기 적은 이음은 그 사진에서 픽셀 단위로 읽어 낸 것이다.
%
% 만드는 법:  mptopdf KTb.mp    -> KTb-1.pdf ... (PDF)
%             mpost   KTb.mp    -> KTb.1 ...     (EPS)
% 이 파일은 홀로 선다---바깥에서 input하는 것도, TeX 라벨도 없다.
%
% --- 길이를 매개변수로 --------------------------------------------------------
% 셋 다 n을 받아 길이를 늘이고 줄일 수 있다. 사진에 걸린 것은 그 가운데 한 크기일
% 뿐이다. 읽어 낸 투어를 크누스의 열 코드로 되옮겨 보니 주기가 또렷했고, 앞뒤
% 마감만 떼어 내면 가운데를 얼마든지 늘일 수 있었다.
%
%   bandleft(n)   3x(4n+16)   사진은 n=3 (3x28)
%   bandmid(n)    3x(4n+10)   사진은 n=4 (3x26)
%   bandright(n)  3x(8n+12)   사진은 n=2 (3x28)
%
% n=0..7을 모두 지어 확인했다---어디서나 모든 칸이 차수 2이고 고리가 하나다.
% 이음 수는 늘 칸 수와 같다(E=V). 가운데와 오른쪽은 주기를 한 벌만 쓰면 홀짝에
% 따라 고리가 둘로 갈려서, 두 벌을 한 주기로 묶어 두었다. 그래서 가운데의 주기가
% 4열, 오른쪽이 8열이다.
%
% --- 어떻게 읽어 냈나 ---------------------------------------------------------
% KTb.jpg는 정면에서 찍혀 원근 왜곡이 없고 배경 타일이 격자 구실을 해서, 앞서
% NKd.jpg를 읽을 때보다 훨씬 수월했다. 자동상관으로 재니 세 띠 모두 세로 주기가
% 422px이고 칸 크기는 105.3px이었다. 격자의 위상은 눈대중으로 정하지 않고
% "모든 칸의 차수가 2가 되는가"를 점수로 삼아 탐색해 얻었다---맞는 격자에서만
% 그 값이 최대가 되기 때문이다.
%
% --- 믿을 만한가 -------------------------------------------------------------
% 세 겹으로 검산했다.
%
%   1. 차수. 246칸이 모두 정확히 차수 2이고, 띠마다 고리가 하나뿐이다.
%   2. 역방향. 사진의 밝은 픽셀 14만 개 가운데 여기 적은 이음으로 설명되지
%      않는 것이 하나도 없다. 빠뜨린 이음이 없다는 뜻이다.
%   3. 분리도. 후보 이음마다 선분을 따라 최저 밝기를 재면, 있는 것은 228~253,
%      없는 것은 18~28이다. 틈이 200을 넘으니 애매한 판정이 하나도 없다.
%
% 셋은 서로 다른 투어다. 왼쪽과 오른쪽은 크기가 같은데도 뒤집거나 돌려서 포갤 수
% 없다. 가운데가 3x26인 것이 반갑다---크누스가 적어 둔 3x(12n+14)의 n=1이 26이다.

numeric uu; uu := 8;   % 한 칸의 크기

% 이음 하나. 행이 아래로 자라야 하니 y를 뒤집는다. 그래서 그냥 그리면 벽에
% 걸린 그대로 세로로 선다. 눕히려면 image로 떠서 -90도 돌리면 된다.
def e(expr ra, ca, rb, cb) =
  draw (ca*uu, -ra*uu)--(cb*uu, -rb*uu);
enddef;

def blackpen = drawoptions(withpen pencircle scaled .5pt); enddef;

% ===== 왼쪽 띠 --- 3x(4n+16), 이음 12n+48개 =====
% 사진에 걸린 것은 n=3, 곧 3x28이다.

% 앞 마감. 열 0..7이 제 몫이고 뒤쪽이 첫 주기와 맞물린다.
def leftcap =
  e(0,0, 2,1); e(0,0, 1,2); e(1,0, 3,1);
  e(1,0, 0,2); e(2,0, 0,1); e(2,0, 1,2);
  e(3,0, 1,1); e(3,0, 2,2); e(4,0, 6,1);
  e(4,0, 5,2); e(5,0, 3,1); e(5,0, 4,2);
  e(6,0, 4,1); e(6,0, 7,2); e(7,0, 6,2);
  e(0,1, 2,2); e(1,1, 3,2); e(2,1, 0,2);
  e(4,1, 6,2); e(5,1, 3,2); e(5,1, 7,2);
  e(6,1, 4,2); e(7,1, 5,2);
enddef;

% 주기 4열. 닫힌 투어는 칸마다 이음이 둘이라 이음 수가 칸 수와 같으니 4*3 = 12이다.
def leftper =
  e(-1,0, 1,1); e(0,0, 2,1); e(0,0, 1,2);
  e(1,0, -1,1); e(1,0, 0,2); e(2,0, 0,1);
  e(2,0, 3,2); e(3,0, 2,2); e(0,1, 2,2);
  e(1,1, 3,2); e(2,1, 0,2); e(3,1, 1,2);
enddef;

% 뒤 마감. 마지막 주기가 끝난 자리를 원점으로 적었다.
def leftend =
  e(-1,0, 1,1); e(0,0, 2,1); e(0,0, 1,2);
  e(1,0, -1,1); e(1,0, 0,2); e(2,0, 0,1);
  e(2,0, 3,2); e(3,0, 1,1); e(3,0, 4,2);
  e(4,0, 6,1); e(4,0, 3,2); e(5,0, 3,1);
  e(5,0, 7,1); e(6,0, 5,2); e(6,0, 7,2);
  e(7,0, 5,1); e(7,0, 6,2); e(0,1, 2,2);
  e(2,1, 0,2); e(3,1, 1,2); e(4,1, 2,2);
  e(4,1, 6,2); e(5,1, 7,2); e(6,1, 4,2);
  e(7,1, 5,2);
enddef;

vardef bandleft(expr n) =
  save pp; picture pp;
  blackpen; pp := image(leftper);
  image(
    leftcap;
    for t = 0 upto n-1: draw pp shifted (0, -(8 + 4t)*uu); endfor
    draw image(leftend) shifted (0, -(8 + 4n)*uu);
  )
enddef;

% ===== 가운데 띠 --- 3x(4n+10), 이음 12n+30개 =====
% 사진에 걸린 것은 n=4, 곧 3x26이다.

% 앞 마감. 열 0..5이 제 몫이고 뒤쪽이 첫 주기와 맞물린다.
def midcap =
  e(0,0, 2,1); e(0,0, 1,2); e(1,0, 3,1);
  e(1,0, 0,2); e(2,0, 0,1); e(2,0, 1,2);
  e(3,0, 1,1); e(3,0, 5,1); e(4,0, 3,2);
  e(4,0, 5,2); e(5,0, 3,1); e(5,0, 4,2);
  e(0,1, 2,2); e(1,1, 3,2); e(2,1, 0,2);
  e(4,1, 2,2);
enddef;

% 주기 4열. 닫힌 투어는 칸마다 이음이 둘이라 이음 수가 칸 수와 같으니 4*3 = 12이다.
def midper =
  e(0,0, -2,1); e(0,0, 1,2); e(1,0, -1,1);
  e(1,0, 0,2); e(2,0, 0,1); e(2,0, 3,2);
  e(3,0, 1,1); e(3,0, 2,2); e(0,1, -2,2);
  e(1,1, -1,2); e(2,1, 0,2); e(3,1, 1,2);
enddef;

% 뒤 마감. 마지막 주기가 끝난 자리를 원점으로 적었다.
def midend =
  e(0,0, 2,1); e(0,0, -1,2); e(1,0, -1,1);
  e(1,0, 3,1); e(2,0, 1,2); e(2,0, 3,2);
  e(3,0, 1,1); e(3,0, 2,2); e(-2,1, 0,2);
  e(0,1, -2,2); e(0,1, 2,2); e(1,1, 3,2);
  e(2,1, 0,2); e(3,1, 1,2);
enddef;

vardef bandmid(expr n) =
  save pp; picture pp;
  blackpen; pp := image(midper);
  image(
    midcap;
    for t = 0 upto n-1: draw pp shifted (0, -(6 + 4t)*uu); endfor
    draw image(midend) shifted (0, -(6 + 4n)*uu);
  )
enddef;

% ===== 오른쪽 띠 --- 3x(8n+12), 이음 24n+36개 =====
% 사진에 걸린 것은 n=2, 곧 3x28이다.

% 앞 마감. 열 0..8이 제 몫이고 뒤쪽이 첫 주기와 맞물린다.
def rightcap =
  e(0,0, 2,1); e(0,0, 1,2); e(1,0, 3,1);
  e(1,0, 0,2); e(2,0, 0,1); e(2,0, 1,2);
  e(3,0, 1,1); e(3,0, 4,2); e(4,0, 3,2);
  e(4,0, 5,2); e(5,0, 3,1); e(5,0, 7,1);
  e(6,0, 8,1); e(6,0, 5,2); e(7,0, 5,1);
  e(7,0, 6,2); e(8,0, 7,2); e(0,1, 2,2);
  e(1,1, 3,2); e(2,1, 0,2); e(4,1, 2,2);
  e(4,1, 6,2); e(5,1, 7,2); e(6,1, 4,2);
  e(6,1, 8,2);
enddef;

% 주기 8열. 닫힌 투어는 칸마다 이음이 둘이라 이음 수가 칸 수와 같으니 8*3 = 24이다.
def rightper =
  e(-1,0, 0,2); e(0,0, -2,1); e(0,0, 2,1);
  e(1,0, 3,1); e(1,0, 0,2); e(2,0, 0,1);
  e(2,0, 1,2); e(3,0, 2,2); e(3,0, 4,2);
  e(4,0, 2,1); e(4,0, 6,1); e(5,0, 7,1);
  e(5,0, 4,2); e(6,0, 4,1); e(6,0, 5,2);
  e(7,0, 6,2); e(-1,1, 1,2); e(0,1, 2,2);
  e(1,1, -1,2); e(1,1, 3,2); e(3,1, 5,2);
  e(4,1, 6,2); e(5,1, 3,2); e(5,1, 7,2);
enddef;

% 뒤 마감. 마지막 주기가 끝난 자리를 원점으로 적었다.
def rightend =
  e(-1,0, 1,1); e(0,0, -2,1); e(0,0, 2,1);
  e(1,0, 0,2); e(1,0, 2,2); e(2,0, 0,1);
  e(2,0, 1,2); e(-1,1, 1,2); e(0,1, 2,2);
  e(1,1, -1,2); e(2,1, 0,2);
enddef;

vardef bandright(expr n) =
  save pp; picture pp;
  blackpen; pp := image(rightper);
  image(
    rightcap;
    for t = 0 upto n-1: draw pp shifted (0, -(9 + 8t)*uu); endfor
    draw image(rightend) shifted (0, -(9 + 8n)*uu);
  )
enddef;

% 사진처럼 셋을 나란히 세운다. 벽에 걸린 크기 그대로다.
def allthree =
  blackpen;
  draw bandleft(3);
  draw bandmid(4)   shifted (6uu, -uu);
  draw bandright(2) shifted (12uu, 0);
  drawoptions();
enddef;

beginfig(1); allthree; endfig;

% 하나씩. 길이를 바꾸려면 n만 고치면 된다.
beginfig(2); blackpen; draw bandleft(3);  drawoptions(); endfig;
beginfig(3); blackpen; draw bandmid(4);   drawoptions(); endfig;
beginfig(4); blackpen; draw bandright(2); drawoptions(); endfig;

% 눕히고 싶으면 -90도.
beginfig(5); blackpen; draw bandleft(3) rotated -90; drawoptions(); endfig;

end.
