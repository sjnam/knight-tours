% knightframe.mp — 크누스의 별무늬 액자를 세로 h, 가로 w를 받아 그리는 자립 매크로.
%
% frame.go가 내놓는 framedef.mp은 크기 한 벌을 좌표로 펼쳐 담은 생성물이라 크기를
% 바꾸려면 Go를 다시 돌려야 한다. 이 파일은 같은 액자를 MetaPost만으로 짓는다.
% 크기가 그리는 시점에 정해지므로 한 문서에서 여러 크기를 함께 쓸 수 있다.
%
%   input knightframe;
%   beginfig(1); frame(103, 73, black, white, .3pt); endfig;
%
% h와 w는 저마다 13 이상이면서 6으로 나눈 나머지가 1이어야 한다.
%
% frame.go가 거르기와 탐색으로 알아내는 것을 여기서는 표에서 꺼내 쓴다. 그래서 이
% 매크로는 거르기도 중복 제거도 탐색도 없는 곧은 그리기다. 조건에 맞는 어떤 h, w에서도
% frame.go와 같은 액자가 나오는데, 근거는 넷이다. Nh=6p+1, Nw=6q+1로 둔다.
%
% 하나. isBorder는 늘 참이라 쳐내는 이음이 없다. 표만 보면 안다 -- 마디 칸은 행이 최대
% 2라 r<3이 무조건 참이고, 네 매듭 모두 행이 3 이상인 칸은 열이 최대 2라 c<3이 무조건
% 참이다. 크기와 무관하다.
%
% 둘. 중복 간선이 없다. 겹침은 매듭-마디, 마디-마디, 매듭-매듭(변이 13칸일 때) 셋뿐이고
% 셋 다 크기와 무관한 국소 배치다. 나이트 행마가 두 열을 넘지 않고 조각이 정확히 두 열씩
% 겹치기 때문이다. 그 셋을 다 담는 크기 16개 x 배치 256가지에서 중복 0회.
%
% 셋. 통하는 모서리 배치의 집합이 (p mod 4, q mod 4)에만 달렸다. 마디 m개짜리 변은 양 끝
% 항구를 잇는 짝 무늬 pattern(m)으로 요약되고(내부 고리는 늘 0), 마디를 하나 더 까는 것은
% 오른쪽 항구에만 붙으므로 pattern(m+1)=G(pattern(m))인 결정적 점화식이다. m=1..9에서
% pattern(m+4)=pattern(m)이니 귀납으로 m>=1 전부에서 주기가 4다. 변이 6t+1이면 m=t-2라
% 이것이 곧 p, q의 주기 4다. m=0(변이 13칸)만 귀납 밖인데 그때는 다른 축의 주기가 살아
% 있고 13x13 하나만 직접 보면 덮인다. 밑수는 p,q=2..10(81개 크기, 나머지류 열여섯 가지
% 전부)에서 일관했다. 고르는 법(0123 먼저, 안 되면 가장 작은 코드)도 frame.go와 같으므로
% 고른 배치가 일치한다.
%
% 넷. 배치가 같으면 그리는 간선이 같다. 같은 표, 같은 변환, 같은 오프셋에 거르기도 중복
% 제거도 없으니 구성상 그렇다. 크기 169개(p,q=2..14)에서 framedef.mp과 EPS 선분 집합을
% 맞대어 불일치 0.
%
% 셋의 귀납은 점화식의 주기를 프로그램으로 확인한 것이고, 둘의 "겹침은 그 셋뿐"은 기하에
% 대한 논증이다. 손으로 쓴 정리는 아니다.
%
% 대신 frame.go가 하던 검산(고리가 하나인지, 재료 지문)은 여기에 없다. 원리와 그 검산은
% frame.w에 있고, 이 파일은 거기서 나온 결과를 쓰는 가벼운 판이다.
%
% 둘이 실제로 갈리는 데는 한 곳뿐이다. MetaPost의 수 한계가 4096이라 좌표 (N-1)/2*6이
% 그 안에 들어야 하므로 N이 1365쯤을 넘으면 이 파일은 넘치고 frame.go는 멀쩡하다.

numeric uu; uu := 6;   % 한 칸의 크기

vardef md(expr a, b) = a - b*floor(a/b) enddef;

% 마디 -- 곧은 변을 채우는 주기 여섯 칸 별무늬. 이음 18개.
% 차수가 모두 2이면 이음 수와 칸 수가 같고, 한 주기가 6x3 = 18칸이라 18이다.
pair moda[], modb[]; numeric nmod; nmod := 0;
def m(expr ra, ca, rb, cb) =
  nmod := nmod + 1; moda[nmod] := (ra,ca); modb[nmod] := (rb,cb);
enddef;
  m(0,0,1,2); m(1,0,2,2); m(0,1,1,3);
  m(1,1,0,3); m(2,1,1,3); m(2,1,0,2);
  m(0,2,2,3); m(1,2,2,4); m(2,2,1,4);
  m(0,3,1,5); m(2,3,0,4); m(0,4,2,5);
  m(1,4,2,6); m(2,4,1,6); m(0,5,1,7);
  m(0,5,2,6); m(1,5,0,7); m(2,5,0,6);

% 매듭 -- 모서리를 도는 무늬 넷. 저마다 이음 30개이고, 30은 크기와 무관한 상수다.
% 넷이 서로 같지 않은 것이 핵심이다. 1번과 2번만 같은 꼴이라 실은 세 종류다.
pair kna[][], knb[][]; numeric nkn[], cur;
def kb(expr j) = cur := j; nkn[j] := 0; enddef;
def k(expr ra, ca, rb, cb) =
  nkn[cur] := nkn[cur] + 1; kna[cur][nkn[cur]] := (ra,ca); knb[cur][nkn[cur]] := (rb,cb);
enddef;
  kb(0);
  k(0,0,1,2); k(0,0,2,1); k(0,1,1,3);
  k(0,1,2,2); k(0,2,1,0); k(0,2,1,4);
  k(0,3,2,2); k(0,3,2,4); k(0,4,1,6);
  k(0,4,2,5); k(0,5,2,4); k(0,6,1,4);
  k(1,0,3,1); k(1,1,2,3); k(1,1,3,0);
  k(1,2,2,0); k(1,3,2,5); k(1,5,2,3);
  k(2,0,3,2); k(2,1,4,0); k(3,0,4,2);
  k(3,1,5,2); k(3,2,5,1); k(4,0,6,1);
  k(4,1,6,0); k(4,1,6,2); k(4,2,5,0);
  k(5,0,6,2); k(5,1,7,0); k(5,2,7,1);
  kb(1);
  k(0,0,1,2); k(0,0,2,1); k(0,1,1,3);
  k(0,1,2,0); k(0,2,1,0); k(0,2,1,4);
  k(0,3,1,1); k(0,3,2,4); k(0,4,1,6);
  k(0,4,2,5); k(0,5,2,4); k(0,6,1,4);
  k(1,0,2,2); k(1,1,2,3); k(1,2,3,1);
  k(1,3,2,5); k(1,5,2,3); k(2,0,3,2);
  k(2,1,4,0); k(2,2,3,0); k(3,0,4,2);
  k(3,1,5,2); k(3,2,5,1); k(4,0,6,1);
  k(4,1,6,0); k(4,1,6,2); k(4,2,5,0);
  k(5,0,6,2); k(5,1,7,0); k(5,2,7,1);
  kb(2);
  k(0,0,1,2); k(0,0,2,1); k(0,1,1,3);
  k(0,1,2,0); k(0,2,1,0); k(0,2,1,4);
  k(0,3,1,1); k(0,3,2,4); k(0,4,1,6);
  k(0,4,2,5); k(0,5,2,4); k(0,6,1,4);
  k(1,0,2,2); k(1,1,2,3); k(1,2,3,1);
  k(1,3,2,5); k(1,5,2,3); k(2,0,3,2);
  k(2,1,4,0); k(2,2,3,0); k(3,0,4,2);
  k(3,1,5,2); k(3,2,5,1); k(4,0,6,1);
  k(4,1,6,0); k(4,1,6,2); k(4,2,5,0);
  k(5,0,6,2); k(5,1,7,0); k(5,2,7,1);
  kb(3);
  k(0,0,1,2); k(0,0,2,1); k(0,1,1,3);
  k(0,1,2,2); k(0,2,1,0); k(0,2,1,4);
  k(0,3,1,1); k(0,3,2,4); k(0,4,1,6);
  k(0,4,2,5); k(0,5,2,4); k(0,6,1,4);
  k(1,0,3,1); k(1,1,2,3); k(1,2,2,0);
  k(1,3,2,5); k(1,5,2,3); k(2,0,3,2);
  k(2,1,4,0); k(2,2,3,0); k(3,0,4,2);
  k(3,1,5,2); k(3,2,5,1); k(4,0,6,1);
  k(4,1,6,0); k(4,1,6,2); k(4,2,5,0);
  k(5,0,6,2); k(5,1,7,0); k(5,2,7,1);

% 어느 매듭을 어느 모서리에 놓을지. 네 자리를 4진수 한 수에 담았다(0123 -> 228).
% 크누스의 0123은 p mod 4가 0이나 1일 때만 통한다 -- q와는 무관하다. 배치가 네 모서리를
% 구별하는데 위아래 변은 Nw, 좌우 변은 Nh를 쓰기 때문이다. 나머지 여덟 경우가 아래 표다.
numeric atbl[][];
  atbl[2][0] :=  53;   % 1130
  atbl[2][1] :=  13;   % 1300
  atbl[2][2] :=  21;   % 1110
  atbl[2][3] :=  13;   % 1300
  atbl[3][0] :=  19;   % 3010
  atbl[3][1] :=  13;   % 1300
  atbl[3][2] :=  19;   % 3010
  atbl[3][3] :=  13;   % 1300

vardef asgcode(expr p, q) =
  if (md(p,4)=0) or (md(p,4)=1): 228 else: atbl[md(p,4)][md(q,4)] fi
enddef;

% 칸을 (행,열) 짝으로 담으니 네 변으로 옮기는 변환이 조건식 하나로 끝난다.
% 0 위: c가 오른쪽으로. 1 오른: c가 아래로. 2 아래: c가 왼쪽으로. 3 왼: c가 위로.
vardef xf(expr i, nh, nw, z) =
  if i=0: z
  elseif i=1: (ypart z, nw-1-xpart z)
  elseif i=2: (nh-1-xpart z, nw-1-ypart z)
  else: (nh-1-ypart z, xpart z) fi
enddef;

% 칸을 종이 위 점으로. 가운데가 원점이고 행은 아래로 자란다.
vardef pos(expr nh, nw, z) =
  ((ypart z - (nw-1)/2)*uu, -(xpart z - (nh-1)/2)*uu)
enddef;

% line 선 색, bg 배경색, pw 선 굵기. expr이라 이름 색, RGB 셋, CMYK 넷을 다 받는다.
def frame(expr h, w, line, bg, pw) =
begingroup
  save p, q, cd, sl, aa, i, j, off, xr, yr;
  numeric p, q, cd, sl[], aa[], i, j, off, xr, yr;
  p := (h-1)/6; q := (w-1)/6;
  cd := asgcode(p,q);
  for i = 0 upto 3: aa[i] := md(floor(cd/(4**i)), 4); endfor
  sl[0] := w; sl[1] := h; sl[2] := w; sl[3] := h;
  xr := (w-1)/2*uu; yr := (h-1)/2*uu;
  fill (-xr,-yr)--(xr,-yr)--(xr,yr)--(-xr,yr)--cycle withcolor bg;
  drawoptions(withpen pencircle scaled pw withcolor line);
  for i = 0 upto 3:
    % 변마다 마디를 여섯 칸씩 이어 깔고, 그 끝에 매듭을 얹는다. 변이 짧아
    % sl[i]-13이 5에 못 미치면 마디는 하나도 깔리지 않는다 -- 13x13이 그렇다.
    for off = 5 step 6 until sl[i]-13:
      for j = 1 upto nmod:
        draw pos(h,w,xf(i,h,w,moda[j]+(0,off)))
          -- pos(h,w,xf(i,h,w,modb[j]+(0,off)));
      endfor
    endfor
    for j = 1 upto nkn[aa[i]]:
      draw pos(h,w,xf(i,h,w,kna[aa[i]][j]))
        -- pos(h,w,xf(i,h,w,knb[aa[i]][j]));
    endfor
  endfor
  drawoptions();
endgroup
enddef;
