  E(0,0,-3,1); E(1,0,-2,3); E(0,0,-4,0); E(0,0,-4,1); E(0,0,-2,0);
  E(0,0,-2,1); E(1,0,-1,2); E(0,0,-3,0); E(0,0,-3,1); E(0,0,-1,1);
  E(1,0,-1,2); E(1,0,-1,3); E(1,0,0,3); E(0,0,-2,0); E(0,0,-2,1);
  E(0,0,-5,0); E(0,0,-3,0); E(1,0,-1,2);

% 변마다 앞뒤 마감의 길이. 주기가 통하는 구간을 재어 얻었다.
numeric capa[], capb[];
  capa[0] := 4; capb[0] := 4;
  capa[1] := 4; capb[1] := 5;
  capa[2] := 4; capb[2] := 2;
  capa[3] := 7; capb[3] := 2;

% 크기 n의 자리 p에서 어느 무늬를 쓸까. 절반까지는 앞 끝에서 세고 그 뒤는 뒤 끝에서
% 센다. 마감 밖은 여덟 칸 주기로 접는다. 표는 58짜리에서 뽑았으니 뒤 끝은 57부터 센다.
vardef srcpos(expr s, p) =
  if p < floor(nn/2):
    if p < capa[s]: p else: capa[s] + md(p - capa[s], 8) fi
  else:
    begingroup save j; numeric j; j := nn - 1 - p;
      if j < capb[s]: 57 - j else: (57 - capb[s]) - md(j - capb[s], 8) fi
    endgroup
  fi
enddef;

def laydev =
  begingroup save s, p, i, q, rr, cc; numeric s, p, i, q, rr, cc;
    for s = 0 upto 3: for p = 0 upto nn-1:
      q := srcpos(s, p);
      for i = bst[s][q] upto bst[s][q] + bcn[s][q] - 1:
        if s = 0: rr := edr[i];        cc := p + edc[i];
        elseif s = 1: rr := nn-1 + edr[i]; cc := p + edc[i];
        elseif s = 2: rr := p + edr[i];    cc := edc[i];
        else: rr := p + edr[i];            cc := nn-1 + edc[i]; fi
        setedge(rr, cc, edk[i], ekd[i] = 1);
      endfor
    endfor endfor
  endgroup
enddef;

def drawcycle =
  begingroup save r, c, k; numeric r, c, k;
    for r = 0 upto nn-1: for c = 0 upto nn-1: for k = 0 upto 3:
      if known on[r][c][k]: if on[r][c][k]:
        draw (c*uu, -r*uu) -- ((c + dkc[k])*uu, -(r + dkr[k])*uu);
      fi fi
    endfor endfor endfor
  endgroup
enddef;

% 고리 하나를 놓는다. n은 8로 나눈 나머지가 2이고 18 이상이어야 한다.
%   grid  참이면 타일 격자를 함께 깐다.
def showcycle(expr n, grid) =
  begingroup
    boolean on[][][];        % 앞서 그린 것을 지운다
    nn := n;
    drawoptions();
    setboard(nn, nn);
    backdrop(brim);
    if grid: gridboard; fi
    layrule; laydev;
    drawoptions(withpen pencircle scaled hairw withcolor hair);
    drawcycle;
    drawoptions();
  endgroup
enddef;

% ============================================================================
% 옆에 걸린 것 --- KTe.jpg의 되풀이 무늬
% ============================================================================
% 같은 4층에 세로로 긴 걸개가 하나 더 있다(https://cs.stanford.edu/~knuth/KTe.jpg).
% 머슨의 것과 달리 이것은 하나의 큰 고리가 아니다. 사진에서 읽어 내니 61x14 판 위에
% 열넷짜리 작은 고리가 서른셋 놓여 있었고, 서른셋이 모두 같은 무늬의 평행이동이었다.
% 놓인 자리는 세로 다섯 칸, 가로 네 칸 간격의 격자다.
%
% 무늬 하나는 열네 칸을 도는 닫힌 나이트 고리이고 제 길을 가로지르지 않는다. 폭이
% 여섯 칸인데 세로로는 열한 칸에 걸쳐 있어, 세로 간격 다섯보다 훨씬 길다. 곧 이웃한
% 무늬들의 자리가 서로 깊이 물려 들어간다. 그런데도 어느 두 이음이 가로지르지 않으니
% 이것이 이 무늬의 요령이다---나이트가 제 상자 밖으로 나다녀도 옆 상자를 건드리지
% 않는다. 크누스는 이 방식을 모듈을 되풀이해 까는 것으로 적어 두었다.
%
% 판독은 머슨의 것과 같은 방법이다. 칸 크기와 판 크기를 함께 훑어 점수 분포가 가장
% 또렷이 갈리는 격자를 골랐더니 61행 14열, 칸 25.35화소에서 분리도가 압도적이었다
% (있는 것 160~210, 없는 것 0~25). 이음 462개가 모두 차수 2이고 가로지르는 쌍이 0이다.

numeric mr, mc;   % 지금 놓는 무늬의 왼쪽 위 칸

def me(expr ra, ca, rb, cb) =
  draw ((mc + ca)*uu, -(mr + ra)*uu) -- ((mc + cb)*uu, -(mr + rb)*uu);
enddef;

% 무늬 한 벌. 이음 열넷이 곧 칸 열넷이다---닫힌 고리는 칸마다 이음이 둘이니까.
def modknot =
  me(0,0, 2,-1);  me(0,0, 2,1);   me(2,-1, 3,1);
  me(2,1, 4,2);   me(3,1, 5,2);   me(4,0, 5,2);
  me(4,0, 6,1);   me(4,2, 6,3);   me(5,1, 6,3);
  me(5,1, 7,2);   me(6,1, 8,2);   me(7,2, 8,4);
  me(8,2, 10,3);  me(8,4, 10,3);
enddef;

% 무늬를 세로 m벌, 가로 k벌 깐다. 판은 (5m+6)x(4k+2)가 된다---무늬가 세로로 열한 칸,
% 가로로 여섯 칸에 걸치고 간격이 다섯과 넷이기 때문이다. 사진 속 걸개는 m=11, k=3이다.
def showmodules(expr m, k, grid) =
  begingroup save i, j; numeric i, j;
    drawoptions();
    setboard(4k + 2, 5m + 6);
    backdrop(brim);
    if grid: gridboard; fi
    drawoptions(withpen pencircle scaled hairw withcolor hair);
    for i = 0 upto m-1: for j = 0 upto k-1:
      mr := 5i; mc := 4j + 1; modknot;
    endfor endfor
    drawoptions();
  endgroup
enddef;

% ============================================================================
% 엘리베이터 옆 --- KTd.jpg의 걸개 여덟
% ============================================================================
% 같은 4층에 작은 걸개 여덟이 세로로 나란히 걸려 있다
% (https://cs.stanford.edu/~knuth/KTd.jpg). 위에서부터 3x10, 4x10, ..., 10x10이고
% 저마다 그 판에서 가장 긴 비교차 고리다. 크누스는 이런 고리의 최적해를 도슨(Thomas
% Rayner Dawson)과 파울리(Wolfgang Pauly)가 1931년에 8x8에서 찾았고, 그 최적성이
% 1968년에야 기계로 확인되었다고 적어 두었다.
%
% 판독은 앞의 둘과 같은 방법인데, 여기서는 격자를 탐색할 것도 없었다. 걸개마다 제
% 타일 덩이가 따로 있고 그 테두리가 벽보다 훨씬 밝아(255분의 150을 넘는다) 덩이의 네
% 변이 그대로 드러난다. 덩이가 곧 판이니 폭을 열로 나눈 것이 칸 크기(45.1화소)이고
% 첫 칸의 복판은 왼쪽 변에서 반 칸 들어온 자리다. 여덟이 한 벽에 걸려 있어 칸 크기가
% 하나뿐이므로 덩이마다 잰 값의 중앙값을 함께 썼다---넷째 덩이만 오른쪽 변이 어두워
% 폭을 짧게 재었기 때문이다.
%
% 여덟 가운데 일곱은 곧바로 하나의 비교차 고리로 떨어졌고, 6x10 하나만 이음이 하나
% 모자랐다. 차수가 1인 칸 둘이 (3,7)과 (4,9)로 마침 나이트 행마 하나 거리였으니
% 채울 이음이 저절로 정해졌다. 채우고 나면 여덟 다 차수가 모두 2이고, 한 붓에 돌며,
% 가로지르는 이음 쌍이 0이다.
%
% 이음 수는 차례로 10, 16, 22, 28, 36, 42, 50, 54다. 닫힌 나이트 고리는 이음마다
% 칸 빛깔이 바뀌니 길이가 반드시 짝수인데, 그 덕에 6x10을 27로 잘못 읽은 것을 바로
% 알아챌 수 있었다.

def smalla =   % 3x10, 이음 10개
  me(0,1, 1,3); me(0,1, 2,0); me(0,5, 1,3); me(0,5, 1,7);
  me(0,9, 1,7); me(0,9, 2,8); me(1,2, 2,0); me(1,2, 2,4);
  me(1,6, 2,4); me(1,6, 2,8);
enddef;

def smallb =   % 4x10, 이음 16개
  me(0,0, 1,2); me(0,0, 2,1); me(0,4, 1,2); me(0,4, 2,3);
  me(0,7, 1,5); me(0,7, 2,6); me(1,3, 2,1); me(1,3, 3,2);
  me(1,5, 2,3); me(1,6, 2,4); me(1,6, 3,5); me(1,8, 2,6);
  me(1,8, 3,9); me(2,4, 3,2); me(2,7, 3,5); me(2,7, 3,9);
enddef;

def smallc =   % 5x10, 이음 22개
  me(0,0, 1,2); me(0,0, 2,1); me(0,3, 1,5); me(0,3, 2,4);
  me(0,7, 1,5); me(0,7, 2,6); me(0,9, 1,7); me(0,9, 2,8);
  me(1,1, 2,3); me(1,1, 3,2); me(1,2, 2,4); me(1,7, 3,8);
  me(2,1, 4,0); me(2,3, 4,2); me(2,5, 3,7); me(2,5, 4,6);
  me(2,6, 3,8); me(2,8, 4,9); me(3,2, 4,0); me(3,4, 4,2);
  me(3,4, 4,6); me(3,7, 4,9);
enddef;

def smalld =   % 6x10, 이음 28개
  me(0,1, 1,3); me(0,1, 2,2); me(0,5, 1,3); me(0,5, 2,4);
  me(0,7, 1,5); me(0,7, 2,8); me(1,0, 2,2); me(1,0, 3,1);
  me(1,2, 2,4); me(1,2, 3,3); me(1,5, 3,4); me(1,7, 2,5);
  me(1,7, 3,8); me(2,1, 3,3); me(2,1, 4,2); me(2,5, 4,4);
  me(2,6, 3,8); me(2,6, 4,7); me(2,8, 4,9); me(3,1, 5,2);
  me(3,4, 4,2); me(3,5, 4,7); me(3,5, 5,4); me(3,7, 4,9);
  me(3,7, 5,8); me(4,4, 5,2); me(4,6, 5,4); me(4,6, 5,8);
enddef;

def smalle =   % 7x10, 이음 36개
  me(0,0, 1,2); me(0,0, 2,1); me(0,4, 1,2); me(0,4, 2,3);
  me(0,5, 1,7); me(0,5, 2,6); me(0,9, 1,7); me(0,9, 2,8);
  me(1,3, 2,1); me(1,3, 3,2); me(1,5, 2,3); me(1,5, 3,4);
  me(1,6, 2,8); me(1,6, 3,7); me(2,2, 3,0); me(2,2, 4,1);
  me(2,4, 3,2); me(2,4, 4,3); me(2,6, 3,4); me(2,9, 3,7);
  me(2,9, 4,8); me(3,0, 5,1); me(3,3, 4,1); me(3,3, 5,2);
  me(3,5, 4,3); me(3,5, 5,6); me(3,8, 4,6); me(3,8, 5,7);
  me(4,4, 5,2); me(4,4, 5,6); me(4,6, 6,7); me(4,8, 6,9);
  me(5,1, 6,3); me(5,5, 6,3); me(5,5, 6,7); me(5,7, 6,9);
enddef;

def smallf =   % 8x10, 이음 42개
  me(0,0, 1,2); me(0,0, 2,1); me(0,4, 1,2); me(0,4, 2,3);
  me(0,6, 1,4); me(0,6, 2,7); me(0,9, 1,7); me(0,9, 2,8);
  me(1,3, 2,1); me(1,3, 3,2); me(1,4, 3,3); me(1,5, 2,7);
  me(1,5, 3,6); me(1,7, 3,8); me(2,0, 3,2); me(2,0, 4,1);
  me(2,3, 4,2); me(2,4, 3,6); me(2,4, 4,3); me(2,6, 3,8);
  me(2,6, 4,7); me(2,8, 4,9); me(3,3, 5,2); me(3,5, 4,3);
  me(3,5, 5,6); me(3,7, 4,9); me(3,7, 5,8); me(4,1, 6,0);
  me(4,2, 6,1); me(4,4, 5,2); me(4,4, 6,5); me(4,7, 6,8);
  me(5,3, 6,1); me(5,3, 6,5); me(5,5, 6,7); me(5,5, 7,6);
  me(5,6, 6,8); me(5,8, 7,9); me(6,0, 7,2); me(6,4, 7,2);
  me(6,4, 7,6); me(6,7, 7,9);
enddef;

def smallg =   % 9x10, 이음 50개
  me(0,0, 1,2); me(0,0, 2,1); me(0,4, 1,2); me(0,4, 2,3);
  me(0,5, 1,7); me(0,5, 2,6); me(0,9, 1,7); me(0,9, 2,8);
  me(1,3, 2,1); me(1,3, 3,2); me(1,5, 2,3); me(1,5, 3,4);
  me(1,6, 2,8); me(1,6, 3,7); me(2,2, 3,0); me(2,2, 4,1);
  me(2,4, 3,2); me(2,4, 4,3); me(2,6, 3,4); me(2,7, 3,9);
  me(2,7, 4,8); me(3,0, 5,1); me(3,3, 4,1); me(3,3, 5,2);
  me(3,5, 4,3); me(3,5, 5,4); me(3,7, 5,6); me(3,9, 5,8);
  me(4,4, 5,2); me(4,4, 6,3); me(4,6, 5,4); me(4,6, 6,5);
  me(4,8, 5,6); me(5,1, 7,0); me(5,3, 6,1); me(5,3, 7,2);
