  me(7,5, 8,7); me(7,9, 8,7);
enddef;

def smallh =   % 10x10, 이음 54개
  me(0,1, 1,3); me(0,1, 2,2); me(0,5, 1,3); me(0,5, 2,6);
  me(0,8, 1,6); me(0,8, 2,9); me(1,0, 2,2); me(1,0, 3,1);
