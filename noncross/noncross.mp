  me(2,9, 4,8); me(3,1, 5,0); me(3,4, 5,3); me(3,6, 5,7);
  me(4,2, 5,0); me(4,3, 5,1); me(4,4, 6,3); me(4,6, 6,5);
  me(4,8, 6,9); me(5,1, 7,0); me(5,3, 7,2); me(5,5, 6,3);
  me(5,5, 7,4); me(5,7, 6,5); me(5,8, 6,6); me(5,8, 7,7);
  me(6,2, 7,0); me(6,2, 8,1); me(6,4, 7,2); me(6,4, 8,3);
  me(6,6, 7,4); me(6,7, 7,5); me(6,7, 8,6); me(6,9, 7,7);
  me(7,3, 8,1); me(7,3, 9,2); me(7,5, 8,3); me(7,6, 8,4);
  me(7,6, 9,5); me(7,8, 8,6); me(7,8, 9,9); me(8,4, 9,2);
  me(8,7, 9,5); me(8,7, 9,9);
enddef;

% k번째 걸개(k=1..8, 판은 (k+2)x10)를 mr, mc 자리에 그린다.
% 이름에 숫자를 붙이면 안 된다---MetaPost가 배열 첨자로 읽는다. 그래서 a..h다.
def smallcycle(expr k) =
  if k = 1: smalla elseif k = 2: smallb elseif k = 3: smallc
  elseif k = 4: smalld elseif k = 5: smalle elseif k = 6: smallf
  elseif k = 7: smallg else: smallh fi
enddef;

% 걸개 하나만.
def showsmall(expr k, grid) =
  begingroup
    drawoptions();
    setboard(10, k + 2);
    backdrop(brim);
    if grid: gridboard; fi
    drawoptions(withpen pencircle scaled hairw withcolor hair);
    mr := 0; mc := 0; smallcycle(k);
    drawoptions();
  endgroup
enddef;

% 여덟을 사진처럼 세로로 늘어놓는다. 판 사이 틈은 사진에서 재니 한 칸의 1.16배라
% 한 칸으로 잡았다. 전체 높이는 3+4+...+10에 틈 일곱을 더한 쉰아홉 칸이다.
% 바탕을 먼저 통째로 깔고 그 위에 걸개마다 타일과 끈을 얹는다.
def showallsmall(expr grid) =
  begingroup save k, yy; numeric k, yy;
    drawoptions();
    setboard(10, 59);
    backdrop(brim);
    yy := 0;
    for k = 1 upto 8:
      mr := yy; mc := 0;
      if grid:
        setboard(10, k + 2);
        draw image(gridboard) shifted (0, -yy*uu);
      fi
      drawoptions(withpen pencircle scaled hairw withcolor hair);
      smallcycle(k);
      drawoptions();
      yy := yy + k + 3;
    endfor
  endgroup
enddef;

% 사진 속 걸개그림 그대로. 어두운 타일 위에 흰 끈.
beginfig(1); walllook; uu := 9; hairw := .8pt; showcycle(58, true); endfig;

% 책에 실릴 꼴. 흰 종이에 검은 가는 선.
beginfig(2); paperlook; uu := 6; hairw := .3pt; showcycle(58, false); endfig;

% 같은 구성법으로 지은 다른 크기들. 26은 마감 넷이 거의 맞닿아 무늬가 잘 보이고,
% 90은 안쪽 지그재그가 어디까지 뻗는지 보여 준다.
beginfig(3); paperlook; uu := 12; hairw := .4pt; showcycle(26, true);  endfig;
beginfig(4); paperlook; uu := 16; hairw := .5pt; showcycle(18, true);  endfig;
beginfig(5); paperlook; uu := 4;  hairw := .25pt; showcycle(90, false); endfig;

% KTe.jpg의 되풀이 무늬. 6번이 사진 속 걸개 그대로이고, 7번은 무늬 한 벌만 크게
% 보인 것이다. 8번은 가로로 넓게 깔아 무늬끼리 어떻게 물리는지 보여 준다.
beginfig(6); walllook;  uu := 9;  hairw := .8pt; showmodules(11, 3, true); endfig;
beginfig(7); paperlook; uu := 20; hairw := .5pt; showmodules(1, 1, true);  endfig;
beginfig(8); paperlook; uu := 9;  hairw := .4pt; showmodules(4, 8, true);  endfig;

% KTd.jpg의 걸개 여덟. 9번이 사진처럼 죄다 늘어놓은 것이고, 10번부터 17번까지가
% 3x10부터 10x10까지 하나씩이다.
beginfig(9); walllook; uu := 9; hairw := .8pt; showallsmall(true); endfig;
for kk = 1 upto 8:
  beginfig(9 + kk); paperlook; uu := 16; hairw := .5pt; showsmall(kk, true); endfig;
endfor

end.
